{
  "name": "resolve-mcp",
  "version": "0.1.0",
  "description": "MCP server connecting AI assistants to DaVinci Resolve Studio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "resolve-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "bridge",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm run test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "davinci-resolve",
    "video-editing",
    "ai-assistant",
    "claude"
  ],
  "author": "Resolve MCP Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "yaml": "^2.5.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "packageManager": "npm@10.8.0"
}